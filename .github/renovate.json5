{
  extends: ['config:recommended', ':enablePreCommit', 'helpers:pinGitHubActionDigests'],
  schedule: ['before 4am on Saturday'],
  labels: ['deps'],
  minimumReleaseAge: '5 days',
  separateMajorMinor: false,
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  packageRules: [
    {
      groupName: 'all dependencies',
      groupSlug: 'all',
      matchPackageNames: ['*'],
    },
  ],
  automerge: true,
}
